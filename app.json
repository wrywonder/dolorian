{
  "expo": {
    "name": "Dolorian",
    "slug": "dolorian",
    "scheme": "dolorian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF4E9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dolorian.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF4E9"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dolorian.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dolorian uses your location to show nearby hangout spots and your village on the map.",
          "locationAlwaysAndWhenInUsePermission": "Dolorian uses your location in the background to recognize your hangout spots and warn you before sharing that you're out and about.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac5bbfa2-a7a4-40f9-81c6-5ff5d159a1f4"
      }
    }
  }
}
